# ZyX OS virtual-device init overlay.
# The corresponding daemons must be provided by the selected AOSP/LineageOS branch.

on early-init
    write /proc/sys/kernel/sched_child_runs_first 1
    setprop ro.zyx.backend avf
    setprop ro.zyx.guest_contract 1

on boot
    mkdir /data/zyx 0771 system system

# Placeholder contract: do not enable until the AVF guest services exist.
# service zyx-guestd /system/bin/zyx-guestd
#     class core
#     user root
#     group root system
#     disabled
